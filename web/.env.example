# --- Identity (NAME-01: never hardcoded inline; settings-table overrides
# --- take precedence at runtime, these are the env defaults) ---
# Brand name in Latin script (wordmark, meta titles, {brand} in copy).
NEXT_PUBLIC_BRAND_NAME=
# Native-script brand display form, if the brand has one; empty = Latin only.
NEXT_PUBLIC_BRAND_NAME_NATIVE=

# --- Site and infrastructure ---
# Canonical public site URL, no trailing slash (canonical, hreflang, sitemap).
NEXT_PUBLIC_SITE_URL=
# Base URL of the Rust API in api/ that this storefront calls. REQUIRED:
# the build fetches the catalogue, site copy and settings from it.
NEXT_PUBLIC_API_URL=
# The locale pair the storefront serves (LOCALE-01). Exactly two locales,
# comma-separated, first is the default. Default: en,zh-HK
NEXT_PUBLIC_LOCALES=en,zh-HK

# --- Contact and analytics (empty = absent / OFF) ---
# WhatsApp contact number in international format, digits only (e.g. 85291234567).
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX); empty disables GA
# entirely (GA-OFF-01: ships OFF; the C8 privacy check gates turning it on).
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Google Search Console verification token for the meta tag; empty omits the tag.
NEXT_PUBLIC_GSC_VERIFICATION=

# --- Commerce ---
# ISO 4217 currency code driving the money formatter (default HKD).
NEXT_PUBLIC_CURRENCY=HKD

# --- Operational knobs (safe defaults; tuning, not company config) ---
# How long a confirmed stock number may be displayed, ms (commitment 5b
# default 60000; bounds 1000..60000 — the 60s cap IS the 5b bound, so the
# knob can only tighten it, never loosen it).
NEXT_PUBLIC_AVAILABILITY_TTL_MS=60000
# Abort timeout for one data fetch (catalogue, availability), ms
# (default 10000; bounds 100..120000).
NEXT_PUBLIC_FETCH_TIMEOUT_MS=10000
# Revalidation window for cached content fetches (catalogue, site copy,
# settings), seconds (default 60; bounds 1..60 — capped at the commitment 5b
# stale bound). On-demand purge via tags is the D2 admin mutation path.
NEXT_PUBLIC_CONTENT_REVALIDATE_SECONDS=60

# --- Rust API (api/) env: PORT (default 8080), DATABASE_URL (required for
# --- data endpoints), CORS_ORIGIN (default http://localhost:3000),
# --- MAX_POOL_CONNECTIONS (default 5, clamped 1..=64) ---
#
# Settings-table overrides (admin-editable, D2 console) map 1:1 to the
# identity/contact/analytics/currency keys above via the API whitelist:
# brand.name, brand.name_native, site.url, contact.whatsapp,
# analytics.ga_measurement_id, analytics.gsc_verification, currency.
# Resolution: override -> env default (-> code default where a safe default
# exists; the brand name has no default and fails loudly when absent).
