# Canonical public site URL, no trailing slash (used later for canonical, hreflang, sitemap).
NEXT_PUBLIC_SITE_URL=
# Base URL of the Rust API in api/ that this storefront calls.
NEXT_PUBLIC_API_URL=
# WhatsApp contact number in international format, digits only (e.g. 85291234567).
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX); empty disables GA.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Google Search Console verification token for the meta tag; empty omits the tag.
NEXT_PUBLIC_GSC_VERIFICATION=
